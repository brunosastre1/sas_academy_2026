108    /* ============================================================
109       Timing macro
110       ============================================================ */
111    %macro measure_execution(scenario=, program=);
112    
113        %local t0 t1 duration;
114    
115        %put ============================================================;
116        %put STARTING &scenario;
117        %put ============================================================;
118    
119        %let t0=%sysfunc(datetime());
120    
121        %include "&program.";
122    
123        %let t1=%sysfunc(datetime());
124        %let duration=%sysevalf(&t1-&t0);
125    
126        proc sql;
127            insert into work.execution_times
128            values("&scenario.", &duration.);
129        quit;
